<!--
  Game HUD. Panel, Button and ButtonLabel come from the bundled Horizon kit.
  Authored in the kit's own pixel scale (its defaults, such as a 44 high
  button with an 80 minimum width, assume it); HudSystem scales the entity
  by 0.1, so 10 units = 1 cm and the panel is about 30 x 21 cm, small enough
  for the Meta VR Glasses view beside the board. The "-" placeholders are
  replaced at runtime (the title from APP_NAME in src/config.ts; never write
  the app name here). The Levels button shares the title row and the action
  buttons share one row, to keep the panel short; Play again replaces
  Launch and Next during the chapter-complete moment. Dark glass style: a
  dark semi-transparent panel with a thin light border, a plain light title
  (title-badge is a bare wrapper), dark glass buttons with light borders and
  labels, and a brighter blue glass for Launch, Next and Play again. The
  panel border is 2 and its padding 1 more than before, so the size holds.
  Translucent colours are 8-digit hex (#rrggbbaa) in every panel: UIKit
  converts hex from sRGB, but takes rgba() channels as linear (too light).
-->
<style>
  .hud-root {
    flex-direction: column;
    width: 300;
    padding-top: 11;
    padding-bottom: 11;
    padding-left: 15;
    padding-right: 15;
    gap: 7;
    background-color: #0b1220c7;
    border-width: 2;
    border-color: #8fb3e6;
    border-radius: 12;
  }

  .title-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 8;
  }

  .title-badge {
    flex-shrink: 0;
    padding-left: 2;
    padding-right: 2;
    padding-top: 4;
    padding-bottom: 4;
  }

  .title {
    color: #eaf2ff;
    font-size: 24;
    font-weight: 700;
  }

  .info {
    color: #dddfe3;
    font-size: 20;
  }

  .button-row {
    flex-direction: row;
    gap: 10;
    margin-top: 4;
  }

  .button {
    height: 70;
    flex-grow: 1;
    justify-content: center;
    padding-left: 8;
    padding-right: 8;
    background-color: #3068bae0;
    border-width: 2;
    border-color: #b9d3f5;
    border-radius: 12;
    color: #ffffff;
  }

  .xr-button {
    height: 70;
    flex-grow: 1;
    justify-content: center;
    padding-left: 8;
    padding-right: 8;
    background-color: #162238d9;
    border-width: 2;
    border-color: #8fb3e6;
    border-radius: 12;
    color: #eaf2ff;
  }

  .button-label {
    font-size: 24;
    line-height: 30px;
    font-weight: 700;
  }

  .levels-button {
    height: 40;
    justify-content: center;
    background-color: #162238d9;
    border-width: 2;
    border-color: #8fb3e6;
    border-radius: 10;
    color: #eaf2ff;
  }

  .levels-label {
    font-size: 18;
    line-height: 1.2;
  }
</style>
<Panel class="hud-root">
  <div class="title-row">
    <div class="title-badge">
      <div id="title-text" class="title">-</div>
    </div>
    <Button id="levels-button" class="levels-button">
      <ButtonLabel class="levels-label">Levels</ButtonLabel>
    </Button>
  </div>
  <div id="level-text" class="info">-</div>
  <div id="status-text" class="info">-</div>
  <div class="button-row">
    <Button id="launch-button" class="button">
      <ButtonLabel id="launch-label" class="button-label">Launch</ButtonLabel>
    </Button>
    <Button id="next-button" class="button" style="display: none">
      <ButtonLabel class="button-label">Next</ButtonLabel>
    </Button>
    <Button id="play-again-button" class="button" style="display: none">
      <ButtonLabel class="button-label">Play again</ButtonLabel>
    </Button>
    <Button id="xr-button" class="xr-button" style="display: none">
      <ButtonLabel id="xr-label" class="button-label">Enter AR</ButtonLabel>
    </Button>
  </div>
</Panel>
