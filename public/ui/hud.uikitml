<!--
  Game HUD. Panel, Button and ButtonLabel come from the bundled Horizon kit.
  Sizes are UIKit units (centimetres). The title text is filled at runtime
  from APP_NAME in src/config.ts; never write the app name here.
-->
<style>
  .hud-root {
    flex-direction: column;
    width: 30;
    padding-top: 1.5;
    padding-bottom: 1.5;
    padding-left: 1.5;
    padding-right: 1.5;
    gap: 1;
  }

  .title {
    color: #fafaf7;
    font-size: 3;
    font-weight: 700;
  }

  .info {
    color: #dddfe3;
    font-size: 2.5;
  }

  .button-row {
    flex-direction: row;
    gap: 1;
  }

  .button {
    height: 7;
    flex-grow: 1;
    justify-content: center;
  }

  .button-label {
    font-size: 2.8;
  }
</style>
<Panel class="hud-root">
  <div id="title-text" class="title"></div>
  <div id="level-text" class="info"></div>
  <div id="status-text" class="info"></div>
  <div class="button-row">
    <Button id="launch-button" class="button">
      <ButtonLabel class="button-label">Launch</ButtonLabel>
    </Button>
    <Button id="next-button" class="button" style="display: none">
      <ButtonLabel class="button-label">Next</ButtonLabel>
    </Button>
  </div>
  <Button id="xr-button" class="button">
    <ButtonLabel class="button-label">Enter AR</ButtonLabel>
  </Button>
</Panel>
