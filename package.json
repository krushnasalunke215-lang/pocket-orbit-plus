{
  "name": "orbit-puzzle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "iwsdk dev restart --open --foreground",
    "dev:runtime": "vite",
    "dev:down": "iwsdk dev down",
    "dev:status": "iwsdk dev status",
    "reference:status": "iwsdk reference status",
    "reference:warmup": "iwsdk reference warmup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "build": "vite build",
    "preview": "vite preview",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "preview:e2e": "vite preview --outDir dist-e2e --port 4174 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "verify:iwer": "node e2e/iwer/verify-iwer.mjs",
    "solve": "tsx scripts/solve.ts"
  },
  "dependencies": {
    "@iwsdk/core": "1.1.0-rc.2",
    "@pmndrs/uikit": "^1.0.74",
    "@pmndrs/uikit-horizon": "^1.0.74",
    "@pmndrs/uikit-lucide": "^1.0.74",
    "three": "npm:super-three@0.185.0"
  },
  "devDependencies": {
    "@iwsdk/cli": "1.1.0-rc.2",
    "@iwsdk/reference": "1.1.0-rc.2",
    "@iwsdk/vite-plugin-dev": "1.1.0-rc.2",
    "@meta-quest/metavr": "1.10.0",
    "@playwright/test": "1.65.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.185.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "vite": "^7.1.4",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "sharp": "0.35.4",
    "three": "npm:super-three@0.185.0",
    "@iwsdk/xr-input": "1.1.0-rc.2",
    "@iwsdk/locomotor": "1.1.0-rc.2",
    "@iwsdk/scene-composition": "1.1.0-rc.2",
    "iwer": "2.8.0",
    "@iwer/devui": "2.8.0"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  }
}
